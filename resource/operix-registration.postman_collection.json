{
  "info": {
    "name": "Operix Backend API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1"
    },
    {
      "key": "registrationRequestId",
      "value": "00000000-0000-4000-8000-000000000000"
    },
    {
      "key": "todoId",
      "value": "7f90b419-ce32-43db-a7d8-7ebc9ca09dc3"
    }
  ],
  "item": [
    {
      "name": "Registration Requests",
      "item": [
        {
          "name": "Submit Registration Request",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Applicant Name\",\n  \"email\": \"applicant@example.com\"\n}"
            },
            "url": "{{baseUrl}}/registration-requests"
          }
        },
        {
          "name": "List Registration Requests",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/registration-requests?page=1&limit=20"
          }
        },
        {
          "name": "Get Registration Request",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/registration-requests/{{registrationRequestId}}"
          }
        },
        {
          "name": "Approve Registration Request",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"MEMBER\",\n  \"employeeId\": \"EMP-1001\",\n  \"designation\": \"Officer\"\n}"
            },
            "url": "{{baseUrl}}/registration-requests/{{registrationRequestId}}/approve"
          }
        },
        {
          "name": "Reject Registration Request",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Private review reason\"\n}"
            },
            "url": "{{baseUrl}}/registration-requests/{{registrationRequestId}}/reject"
          }
        },
        {
          "name": "Resend Setup Link",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/registration-requests/{{registrationRequestId}}/resend-setup"
          }
        }
      ]
    },
    {
      "name": "Todos",
      "item": [
        {
          "name": "Create Todo",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Review audit checklist\",\n  \"description\": \"Prepare compliance notes\",\n  \"priority\": \"HIGH\",\n  \"category\": \"COMPLIANCE\",\n  \"dueDate\": \"2026-09-10\",\n  \"tags\": [\"audit\", \"q3\"]\n}"
            },
            "url": "{{baseUrl}}/todos"
          }
        },
        {
          "name": "List Todos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/todos?page=1&limit=20&status=ACTIVE&sort=DUE_ON_ASC"
          }
        },
        {
          "name": "Todo Summary",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/todos/summary"
          }
        },
        {
          "name": "Get Todo",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/todos/{{todoId}}"
          }
        },
        {
          "name": "Update Todo",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": null,\n  \"tags\": [\"audit\", \"ready\"]\n}"
            },
            "url": "{{baseUrl}}/todos/{{todoId}}"
          }
        },
        {
          "name": "Complete Todo",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/todos/{{todoId}}/complete"
          }
        },
        {
          "name": "Reopen Todo",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/todos/{{todoId}}/reopen"
          }
        },
        {
          "name": "Clear Completed Todos",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/todos/completed"
          }
        },
        {
          "name": "Delete Todo",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/todos/{{todoId}}"
          }
        }
      ]
    },
    {
      "name": "Internal Cron",
      "item": [
        {
          "name": "Registration Cleanup",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{cronSecret}}" }
            ],
            "url": "{{baseUrl}}/internal/cron/registration-cleanup"
          }
        }
      ]
    }
  ]
}
